---
import Analytics from "@vercel/analytics/astro";

const title = "Site in progress — Timeyin Gordon";
const description = "I'm putting together a new home for my work, experiments and writing. In the meantime, say hello or read Field Notes.";
const canonicalUrl = new URL("/", Astro.site || Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#14161a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=IBM+Plex+Mono:wght@400;500&family=Mrs+Saint+Delafield&display=swap" rel="stylesheet" />
    <Analytics />
  </head>
  <body>
    <div class="desk">
      <div class="cutting-mat" aria-hidden="true"></div>
      <div class="coming-soon-sheet">
        <header>
          <a class="signature" href="/" aria-label="Timeyin Gordon, home">Timeyin Gordon</a>
          <span class="role">Product design engineer</span>
        </header>
        <main>
          <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> A new edition is on its way</p>
          <h1>Site in<br /><em>progress.</em></h1>
          <p class="intro">I’m putting together a new home for my work, experiments and writing. A few things are still on the workbench.</p>
          <a class="contact" href="mailto:gtimeyin@gmail.com">Say hello <span aria-hidden="true">↗</span></a>
        </main>
        <footer>
          <span class="footer-note">In the meantime</span>
          <a href="https://dsfieldnotes.substack.com/">Read Field Notes <span aria-hidden="true">↗</span></a>
        </footer>
      </div>
      <span class="desk-note" aria-hidden="true">Work in progress / Handle with curiosity</span>
    </div>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  html { min-width: 280px; background: #14161a; }
  body { margin: 0; color: #17191b; font-family: "Newsreader", Georgia, serif; }
  body::before {
    content: ""; position: fixed; inset: -25%; pointer-events: none;
    transform: rotate(1.5deg);
    background:
      repeating-linear-gradient(90deg, #ffffff08 0 1px, transparent 1px 44px),
      repeating-linear-gradient(0deg, #ffffff08 0 1px, transparent 1px 44px);
  }
  .desk { position: relative; isolation: isolate; width: min(850px, calc(100% - 112px)); margin: clamp(48px, 9vh, 110px) auto 70px; }
  .cutting-mat {
    position: absolute; inset: 46px 20px -20px -32px; z-index: -1;
    background-color: #e4523c;
    background-image: repeating-linear-gradient(90deg, #60160c30 0 1px, transparent 1px 22px), repeating-linear-gradient(0deg, #60160c30 0 1px, transparent 1px 22px);
    border: 18px solid #e4523c;
    outline: 1px solid #60160c50; outline-offset: -18px;
    transform: rotate(-2deg); box-shadow: 0 18px 45px #0005;
  }
  .coming-soon-sheet { background: #f8f7f4; padding: 0 clamp(28px, 6vw, 70px); box-shadow: 0 2px 4px #0002, 0 24px 64px #0005; }
  header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 29px 0 24px; border-bottom: 1px solid #d8d6ce; }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  a:hover { color: #2e6b53; }
  a:focus-visible { outline: 2px solid #2e6b53; outline-offset: 6px; }
  .signature { font: 30px/1 "Mrs Saint Delafield", cursive; text-decoration: none; white-space: nowrap; }
  .role, .eyebrow, footer, .desk-note { font: 400 10px/1.7 "IBM Plex Mono", monospace; letter-spacing: .09em; text-transform: uppercase; }
  .role { text-align: right; color: #626966; }
  main { padding: clamp(48px, 8vh, 88px) 0 64px; }
  .eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 31px; color: #626966; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #2e6b53; flex-shrink: 0; }
  h1 { margin: 0; font-size: clamp(72px, 10vw, 116px); font-weight: 400; letter-spacing: -.055em; line-height: .94; }
  h1 em { color: #2e6b53; font-weight: 400; }
  .intro { max-width: 370px; margin: 29px 0 27px; color: #43494a; font-size: 20px; line-height: 1.5; }
  .contact { display: inline-flex; align-items: center; gap: 24px; min-height: 44px; font-size: 20px; }
  .contact span { font: 18px/1 sans-serif; }
  footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; border-top: 1px solid #d8d6ce; padding: 20px 0; }
  .footer-note { color: #626966; }
  footer a { display: inline-flex; align-items: center; gap: 16px; min-height: 44px; }
  .desk-note { display: block; padding-top: 42px; color: #a3a6a1; text-align: right; font-size: 9px; }
  @media (max-width: 600px) {
    .desk { width: calc(100% - 48px); margin: 28px auto 36px; }
    .coming-soon-sheet { padding: 0 26px; }
    .cutting-mat { inset: 32px 8px -12px -12px; border-width: 12px; outline-offset: -12px; transform: rotate(-1.2deg); }
    header { align-items: flex-start; gap: 12px; padding: 24px 0; }
    .signature { font-size: 27px; }
    .role { max-width: 100px; font-size: 8px; }
    main { padding: 48px 0 42px; }
    .eyebrow { font-size: 8px; letter-spacing: .06em; margin-bottom: 28px; }
    h1 { font-size: clamp(59px, 15vw, 88px); }
    .intro { font-size: 19px; }
    footer { align-items: flex-start; flex-direction: column; gap: 4px; padding: 23px 0 17px; }
    .desk-note { font-size: 7px; letter-spacing: .04em; padding-top: 32px; }
  }
</style>
