   Retrieval is scoped to this piece, so an answer here can only come from it. */
$("addnote").addEventListener("click",()=>{
  if($("notes").querySelector("input"))return;
  const cur = heads.find(h=>h.getBoundingClientRect().top>=0) || heads[heads.length-1];
  const section = cur ? cur.textContent : "this page";
  const wrap=document.createElement("div");
  wrap.innerHTML=`<input class="noteinput" placeholder="Ask about “${section}”">`;
  $("notes").appendChild(wrap);
  const inp=wrap.querySelector("input"); inp.focus();

  inp.addEventListener("keydown", async ev=>{
    ev.stopPropagation();
    if(ev.key==="Escape"){ wrap.remove(); return; }
    if(ev.key!=="Enter" || !inp.value.trim()) return;

    const q = inp.value.trim();
    wrap.innerHTML = `<div class="note">Reading…</div>`;

    const here = stack[stack.length-1];
    const doc = CORPUS.find(d => d.title === here.title);
    let said = "";
    if(doc){
      try { said = await synthesise(q, [{doc}]); } catch(e){ said = ""; }
    }
    const covered = said && said.indexOf("NOT_COVERED") === -1;
    wrap.innerHTML = `<div class="note"><b>${q}</b>${
      covered ? said : "Not covered in this piece."}</div>`;
  });
});

function restoreRoute(path){
  stack=routeStack(path);
  if(stack[0]===WORK && normalizedPath(path).startsWith("/work/archive/")) WORK.active=1;
  stack.forEach((entry,index)=>render(SHEETS[index],entry));
  layout();
  if(stack.length){
    moveSheet(active,0,true);
    buildToc(); progress();
