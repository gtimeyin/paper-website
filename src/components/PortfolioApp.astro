/* ---------- reading widget ---------- */
let heads=[], sections=[];

function measure(){
  if(!active) return;
  const prose=active.querySelector(".r-body");
  if(!prose.offsetHeight){ sections=[]; $("bar").innerHTML=""; return; }
  const top=el=>el.offsetTop;
  const end=top(prose)+prose.offsetHeight;
  sections=[];
  if(heads.length){
    const at=heads.map(top);
    sections.push({title:"Opening",start:0,end:at[0],el:null});
    heads.forEach((h,i)=>sections.push({title:h.textContent,start:at[i],end:i+1<at.length?at[i+1]:end,el:h}));
  } else {
    sections.push({title:"Page",start:0,end:end,el:null});
  }
  const span=Math.max(1,end);
  $("bar").innerHTML=sections.map((sec,i)=>{
    const w=Math.max(4,(sec.end-sec.start)/span*100);
    return `<button class="seg" style="flex:0 1 ${w}%" data-s="${i}" title="${sec.title}"><i></i></button>`;
  }).join("");
  $("bar").querySelectorAll(".seg").forEach(btn=>btn.addEventListener("click",()=>{
    const sec=sections[+btn.dataset.s];
    moveSheet(active,sec.el||0);
  }));
}

function buildToc(){
  if(!active) return;
  heads=[...active.querySelectorAll(".r-body h2[data-toc]")];
  $("toc").innerHTML=`<a href="#" data-top="1">Opening</a>`+
    heads.map((h,i)=>`<a href="#" data-h="${i}">${h.textContent}</a>`).join("");
  $("toc").querySelectorAll("a").forEach(link=>link.addEventListener("click",ev=>{
    ev.preventDefault();
    moveSheet(active,link.dataset.top?0:heads[+link.dataset.h]);
  }));
  $("notes").innerHTML="";
  measure();
}

function progress(){
  if(!active) return;
  const max=active.scrollHeight-active.clientHeight;
  const pct=max>0?Math.min(100,Math.round(active.scrollTop/max*100)):0;
  $("pct").textContent=pct+"%";
  const pos=active.scrollTop+170;
  let cur=0;
  sections.forEach((sec,i)=>{ if(pos>=sec.start) cur=i; });
  $("bar").querySelectorAll(".seg").forEach((seg,i)=>{
    const sec=sections[i]; if(!sec) return;
    const f=Math.max(0,Math.min(1,(pos-sec.start)/Math.max(1,sec.end-sec.start)));
    seg.firstElementChild.style.width=(f*100)+"%";
    seg.classList.toggle("here",i===cur);
    seg.classList.toggle("done",f>=1);
  });
  const sec=sections[cur];
  $("now").innerHTML=sec?`<b>Now reading</b>${sec.title}`:"";
  $("toc").querySelectorAll("a").forEach((a,i)=>a.classList.toggle("here",i===cur));
}

