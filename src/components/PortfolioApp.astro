}

function paintContents(){
  hideIndexPreview();
  const list = results
    ? results.map(it => CONTENTS.find(c => c.title === it.title) || it)
    : CONTENTS.filter(c => filterBy==="all" || c.grp===filterBy);
  $("contents").innerHTML = list.map((it,i)=>`
    <a class="row" href="${it.path}" data-i="${i}">
      <span class="mk">${it.home || it.date || ""}</span>
      <h3>${it.title}</h3>
      <span class="ty">${it.ty}</span>
      ${AR_SVG}
    </a>`).join("");
  $("contents").querySelectorAll(".row").forEach(row=>{
    const item=list[+row.dataset.i];
    row.addEventListener("mouseenter",()=>showIndexPreview(item,row));
    row.addEventListener("mouseleave",hideIndexPreview);
    row.addEventListener("focus",()=>showIndexPreview(item,row));
    row.addEventListener("blur",hideIndexPreview);
    row.addEventListener("click",event=>{ event.preventDefault(); hideIndexPreview(); push(item); });
  });
}
