/* the gloss: hover reveals it, but it also has to work on a keyboard and a
   touchscreen, so the note is bound to the button's own state */
(() => {
  const g = $("gloss"), note = $("gloss-note");
  if(!g || !note) return;
  let pinned = false;
  const show = on => { note.classList.toggle("on", on); g.setAttribute("aria-expanded", String(on)); };
  g.addEventListener("mouseenter", () => { if(!pinned) show(true); });
  g.addEventListener("mouseleave", () => { if(!pinned) show(false); });
  g.addEventListener("focus",      () => show(true));
  g.addEventListener("blur",       () => { if(!pinned) show(false); });
  g.addEventListener("click", ev => {
    ev.stopPropagation();
    pinned = !pinned; g.classList.toggle("on", pinned); show(pinned);
  });
})();

