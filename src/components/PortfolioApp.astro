   sheet's own return-to-page handler below */
/* ---------- playground: off ----------
   Set to true to bring the desk back. Everything it needs — the props layer,
   the note card, the object copy above, the CSS — is still here and intact;
   this flag only controls whether it is reachable. */
const PLAYGROUND_ENABLED = false;

/* Editorial placeholders. Set to false to strip every note-to-self before launch. */
const DRAFT_NOTES = false;
if(!DRAFT_NOTES){
  const strip = () => document.querySelectorAll(".todo").forEach(n=>n.remove());
  strip();
  const _push = push;
  push = function(e){ _push(e); strip(); };
}

if(PLAYGROUND_ENABLED){
  $("zoom").addEventListener("click",ev=>{ ev.stopPropagation(); toDesk(); });
  $("desk-back").addEventListener("click",toPage);
  /* the set-aside page is its own way back */
  home.addEventListener("click",()=>{ if(body.classList.contains("desk")) toPage(); });
}else{
  ["zoom","props","desk-back","lightnote"].forEach(id=>{
    const el=$(id); if(el) el.remove();
  });
}

document.addEventListener("keydown",e=>{
  if(e.key!=="Escape")return;
  if(PLAYGROUND_ENABLED && body.classList.contains("desk")) toPage();
  else if(body.classList.contains("reading")) routeBack();
  else if(PLAYGROUND_ENABLED) toDesk();
});
</script>
<script>
  import Lenis from "lenis";
  import "lenis/dist/lenis.css";

  const sheetLenis = new Map<HTMLElement, Lenis>();

  document.querySelectorAll<HTMLElement>(".sheet").forEach((wrapper) => {
    const lenis = new Lenis({
      wrapper,
      content: wrapper,
      eventsTarget: wrapper,
      autoRaf: true,
      duration: 0.32,
      smoothWheel: true,
      syncTouch: false,
      wheelMultiplier: 1,
      overscroll: true,
      stopInertiaOnNavigate: true,
      respectReducedMotion: true,
    });

    sheetLenis.set(wrapper, lenis);
  });

  (window as any).__sheetLenis = sheetLenis;
  (window as any).syncSheetLenis?.();
</script>
</body>
</html>
