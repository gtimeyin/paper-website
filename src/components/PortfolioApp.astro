        <span class="mk">${it.marker||String(i+1).padStart(2,"0")}</span>
        <span><h3>${it.title}</h3><p class="m">${it.meta}</p></span>
        ${flat?"":`<svg class="ar" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true"><path d="M3 12L12 3M12 3H5.5M12 3v6.5" stroke="currentColor" stroke-width="1.1"/></svg>`}
      ${flat?"</div>":"</a>"}`).join("") + `</div>`;

  if(e.tabs){
    if(e.active==null) e.active=0;
    const paint = () => {
      const t=e.tabs[e.active];
      bodyEl.innerHTML =
        `<div class="tabs">` + e.tabs.map((tab,i)=>`
          <button class="tab${i===e.active?" on":""}" data-t="${i}">
            ${tab.label}<span class="c">${String(tab.items.length).padStart(2,"0")}</span>
          </button>`).join("") + `</div>` +
        `<p class="tab-note">${e.byline||""}</p>` +
        rowsHTML(t.items, t.flat);
      bodyEl.querySelectorAll(".tab").forEach(btn=>btn.addEventListener("click",()=>{
        e.active=+btn.dataset.t; paint(); buildToc(); progress();
      }));
      if(!t.flat) bodyEl.querySelectorAll(".row").forEach(row=>{
        row.addEventListener("click",event=>{ event.preventDefault(); push(t.items[+row.dataset.i]); });
      });
    };
    paint();
  } else if(e.items){
    bodyEl.innerHTML = (e.intro||"") + rowsHTML(e.items, e.flat) + (e.outro||"") + (e.sign ? SIGNOFF : "");
    if(!e.flat) bodyEl.querySelectorAll(".row").forEach(row=>{
      row.addEventListener("click",event=>{ event.preventDefault(); push(e.items[+row.dataset.i]); });
    });
  } else {
    bodyEl.innerHTML = (e.body || "") + SIGNOFF + nextHTML(e);
    const nx = bodyEl.querySelector(".next-row");
    if(nx) nx.addEventListener("click",event=>{ event.preventDefault(); const n=neighbour(e); if(n) swap(n); });
  }
}

let push = function(e){
  if(stack.length>=2) stack[stack.length-1]=e; else stack.push(e);
  const el=SHEETS[stack.length-1];
  render(el,e); layout();
  moveSheet(el,0,true);
  buildToc(); progress();
  el.querySelector(".r-back").focus({preventScroll:true});
  navigationIndex+=1;
  writeHistory("push");
};

/* moving to the next piece stays at the same depth — it is a sibling, not a
   level down, so the stack must not grow */
function swap(e){
  if(!stack.length) return push(e);
  stack[stack.length-1] = e;
  const el = SHEETS[stack.length-1];
  render(el, e); layout(); moveSheet(el,0,true);
  buildToc(); progress();
  el.querySelector(".r-back").focus({preventScroll:true});
  navigationIndex+=1;
  writeHistory("push");
}

function pop(mode="push"){
  stack.pop(); layout();
  if(stack.length){ buildToc(); progress(); }
  if(mode==="push") navigationIndex+=1;
  writeHistory(mode);
}
function reset(){ stack=[]; layout(); }

function routeBack(){
  if(navigationIndex>0) history.back();
  else if(stack.length) pop("replace");
}

SHEETS.forEach(el=>{
  el.querySelector(".r-back").addEventListener("click",ev=>{ ev.stopPropagation(); routeBack(); });
  el.addEventListener("scroll",()=>{ if(el===active) progress(); });
});

/* The landing carries the whole index; the filter narrows it. Order follows the
   sentence above it — case studies, side projects, then the writing. */
const CONTENTS = [
  /* the type comes from the item itself, so a venture reads Venture and the
     patterns lab reads Lab — not whatever its section is called */
  ...WORK_ITEMS.map(it  => Object.assign({}, it, {ty:it.slug, grp:"work"})),
  ...CRAFT_ITEMS.map(it => Object.assign({}, it, {ty:it.slug, grp:"craft"})),
  ...POSTS.map(it       => Object.assign({}, it, {ty:it.slug, grp:"writing"}))
];

const GROUPS = [
  { id:"all",     label:"Everything" },
  { id:"work",    label:"Work" },
  { id:"craft",   label:"Craft" },
  { id:"writing", label:"Writing" }
];
let filterBy = "all";

const AR_SVG = `<svg class="ar" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true"><path d="M3 12L12 3M12 3H5.5M12 3v6.5" stroke="currentColor" stroke-width="1.1"/></svg>`;


/* ---------- asking ----------
   Retrieval is deterministic and local: the index is searched here, in the
   browser, over Timeyin's own words. The model is only ever shown the passages
   that retrieval already surfaced, and is only asked to write one or two
   sentences over them. It cannot choose its own sources, so it cannot invent a
   job, a client or a date — the worst failure mode for a site like this.
   If the model is unreachable the retrieval still stands on its own. */

const STOP = new Set(("a an the and or but of to in on for with about at by from is are was were be been "+
  "do does did he she it they what which who whom whose how why when where has have had "+
  "his her their any some this that these those you your i me my as into over under").split(" "));

const CORPUS = (() => {
  const strip = html => { const d = document.createElement("div"); d.innerHTML = html || ""; return d.textContent.replace(/\s+/g," ").trim(); };
  const out = [];
  const add = (item, grp, ty) => out.push({
    item, grp, ty,
    title: item.title,
    meta: item.meta || "",
    text: (item.body ? strip(item.body) : "") + " " + strip(item.intro||"") + " " + strip(item.outro||"")
  });
  WORK_ITEMS.forEach(i => add(i, "work", i.slug));
  CRAFT_ITEMS.forEach(i => add(i, "craft", i.slug));
  POSTS.forEach(i => add(i, "writing", i.slug));
  add(ABOUT, "about", "About");
  return out;
})();

function terms(q){
  return q.toLowerCase().replace(/[^a-z0-9\s-]/g," ").split(/\s+/)
    .filter(w => w.length > 2 && !STOP.has(w));
}

function retrieve(q, n){
  const ts = terms(q);
  if(!ts.length) return [];
  const scored = CORPUS.map(doc => {
    const body = doc.text.toLowerCase(), title = doc.title.toLowerCase(), meta = doc.meta.toLowerCase();
    let sc = 0;
    ts.forEach(w => {
      const e = w.replace(/[.*+?^${}()|[\]\\]/g,"\\$&");
      /* an exact word counts double a prefix match, so "design" does not let
         "Designing" outrank a piece actually about design systems */
      const exact  = new RegExp("\\b" + e + "\\b", "g");
      const prefix = new RegExp("\\b" + e, "g");
      const w2 = (str, mult) =>
        ((str.match(exact) || []).length * 2 + (str.match(prefix) || []).length) * mult;
      sc += w2(body, 1) + w2(title, 5) + w2(meta, 3);
    });
    /* the whole phrase appearing anywhere is worth more than its parts */
    const phrase = q.toLowerCase().trim();
    if(phrase.length > 8 && (body.indexOf(phrase) > -1 || title.indexOf(phrase) > -1)) sc += 20;
    return { doc, sc };
  }).filter(r => r.sc > 0).sort((a,b) => b.sc - a.sc);
  return scored.slice(0, n || 4);
}

async function synthesise(){
  /* Keep launch search entirely client-side. A future server endpoint can add
     synthesis without exposing a provider key in the browser. */
  return "";
}

let results = null;
const hoverPreview=$("index-preview");
const hoverPreviewTitle=$("index-preview-title");
const hoverPreviewType=$("index-preview-type");
const previewPointer=window.matchMedia("(hover:hover) and (pointer:fine)");
const previewColours={work:"#2E6B53",craft:"#C45B43",writing:"#526B8A"};

function hideIndexPreview(){
  hoverPreview.classList.remove("on");
}

function showIndexPreview(item,row){
  if(!previewPointer.matches||window.innerWidth<=1100) return;
  hoverPreviewTitle.textContent=item.title;
  hoverPreviewType.textContent=item.ty||item.slug||"Preview";
  hoverPreview.style.setProperty("--preview-accent",previewColours[item.grp]||"#2E6B53");

  const rect=row.getBoundingClientRect();
  const half=(hoverPreview.offsetHeight||340)/2;
  const center=Math.max(24+half,Math.min(window.innerHeight-24-half,rect.top+rect.height/2));
  hoverPreview.style.top=center+"px";
  hoverPreview.classList.add("on");
}

function clearAsk(){
  results = null; $("ask").value = "";
  const a = $("answer"); a.hidden = true; a.innerHTML = "";
  paintFilter(); paintContents();
}

async function runAsk(q){
  const a = $("answer");
  const hits = retrieve(q, 4);

  if(!hits.length){
    results = [];
    a.hidden = false;
    a.innerHTML = `<p class="kicker">Nothing in the index</p>
      <p class="said">He has not written about that here. The index covers the work,
      the side projects and the field notes — nothing beyond them.</p>
      <button class="clear" id="clearask">Clear</button>`;
    $("clearask").addEventListener("click", clearAsk);
    paintContents();
    return;
  }

  results = hits.map(h => h.doc.item);
  paintContents();
  a.hidden = false;
  a.innerHTML = `<p class="kicker">Reading ${hits.length} piece${hits.length>1?"s":""}…</p>`;

  let said = "";
  try { said = await synthesise(q, hits); } catch(e){ said = ""; }

  const covered = said && said.indexOf("NOT_COVERED") === -1;
  a.innerHTML =
    `<p class="kicker">${covered ? "From his own writing" : "Closest in the index"}</p>` +
    (covered ? `<p class="said">${said}</p>` : "") +
    `<p class="caveat">${covered
        ? "Answered only from the pieces listed below — every source is open underneath, so you can check it."
        : "The answer is the work itself; these are the pieces that match."}</p>
     <button class="clear" id="clearask">Clear</button>`;
  $("clearask").addEventListener("click", clearAsk);
}

$("ask").addEventListener("keydown", ev => {
  ev.stopPropagation();
  if(ev.key === "Enter" && $("ask").value.trim()){ filterBy = "all"; paintFilter(); runAsk($("ask").value.trim()); }
  if(ev.key === "Escape") clearAsk();
});

function paintFilter(){
  $("filter").innerHTML = GROUPS.map(g=>{
    const n = g.id==="all" ? CONTENTS.length : CONTENTS.filter(c=>c.grp===g.id).length;
    return `<button data-g="${g.id}" role="tab" aria-selected="${g.id===filterBy}"
             class="${g.id===filterBy?"on":""}">${g.label}<span class="n">${n}</span></button>`;
  }).join("");
  $("filter").querySelectorAll("button").forEach(btn=>{
    btn.addEventListener("click",ev=>{
      ev.stopPropagation();
      filterBy = btn.dataset.g; results = null;
      $("ask").value = ""; $("answer").hidden = true;
      paintFilter(); paintContents();
    });
