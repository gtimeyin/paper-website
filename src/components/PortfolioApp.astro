const $=id=>document.getElementById(id);
const body=document.body, home=$("home"), pad=$("pad");
const SHEETS=[$("read"), $("read2")];
const HOME_TITLE="Timeyin Gordon — Product design engineer";

/* Lenis is initialized after this inline application script. Until it is ready,
   navigation falls back to the browser's native scrolling. */
function moveSheet(el,target,immediate=false){
  const lenis=window.__sheetLenis&&window.__sheetLenis.get(el);
  if(lenis){
    lenis.scrollTo(target,{immediate,force:true,duration:immediate?undefined:.32});
    return;
  }
  if(typeof target==="number") el.scrollTo({top:target,behavior:immediate?"auto":"smooth"});
  else target.scrollIntoView({behavior:immediate?"auto":"smooth",block:"start"});
}

function syncSheetLenis(){
  const instances=window.__sheetLenis;
  if(!instances) return;
  const current=active||home;
  instances.forEach((lenis,el)=>{ if(el===current) lenis.start(); else lenis.stop(); });
}

/* ---------- the sheet stack ----------
   Level 0 is the landing page. Section pages (Work, Writing) open at level 1.
   A case study opened from Work sits at level 2. Everything steps back a slot
   as the stack deepens, and the pad stays two slots behind the landing sheet. */
let stack=[];
let active=null;
let navigationIndex=0;

function normalizedPath(path){
  const clean=(path||"/").replace(/\/+$/,"");
  return clean||"/";
}

function parentFor(e){
  if(WORK_ITEMS.includes(e)||ARCHIVE.includes(e)) return WORK;
  if(CRAFT_ITEMS.includes(e)) return CRAFT;
  if(POSTS.includes(e)) return WRITING;
  return null;
}

function routeStack(path){
  const target=normalizedPath(path);
  if(target===WORK.path) return [WORK];
  if(target===WRITING.path) return [WRITING];
  if(target===CRAFT.path) return [CRAFT];
  if(target===ABOUT.path) return [ABOUT];
  const item=[...WORK_ITEMS,...ARCHIVE,...CRAFT_ITEMS,...POSTS]
    .find(entry=>entry.path===target||(Array.isArray(entry.aliases)&&entry.aliases.includes(target)));
  if(!item) return [];
  const parent=parentFor(item);
  return parent?[parent,item]:[item];
}

function currentPath(){
  return stack.length?(stack[stack.length-1].path||"/"):"/";
}

function syncTitle(){
  const current=stack[stack.length-1];
  const meta=window.__ROUTE_SEO_MAP__?.[currentPath()]||window.__ROUTE_SEO__;
  document.title=meta?.title||(current&&current.title?`${current.title} — Timeyin Gordon`:HOME_TITLE);
  if(!meta) return;
  const canonical=new URL(meta.canonicalPath||currentPath(),location.origin).href;
  document.querySelector('meta[name="description"]')?.setAttribute("content",meta.description);
  document.querySelector('meta[property="og:title"]')?.setAttribute("content",meta.title);
  document.querySelector('meta[property="og:description"]')?.setAttribute("content",meta.description);
  document.querySelector('meta[property="og:type"]')?.setAttribute("content",meta.type);
  document.querySelector('meta[property="og:url"]')?.setAttribute("content",canonical);
  document.querySelector('meta[name="twitter:title"]')?.setAttribute("content",meta.title);
  document.querySelector('meta[name="twitter:description"]')?.setAttribute("content",meta.description);
  document.querySelector('link[rel="canonical"]')?.setAttribute("href",canonical);
}

function writeHistory(mode){
  const state={...(history.state||{}),portfolio:true,portfolioIndex:navigationIndex};
  history[mode==="replace"?"replaceState":"pushState"](state,"",currentPath());
  syncTitle();
  window.dispatchEvent(new CustomEvent("portfolio:navigate",{detail:currentPath()}));
}

function depth(el,d){ el.classList.remove("d0","d1","d2","d3","d4"); el.classList.add("d"+d); }

function layout(){
  const n=stack.length;
  body.classList.toggle("reading", n>0);
  depth(home, n);
  depth(pad, n+2);
  home.classList.toggle("back", n>0);
  SHEETS.forEach((el,i)=>{
    if(i<n){ el.classList.remove("away"); depth(el, n-1-i); el.classList.toggle("back", i<n-1); }
    else { el.classList.add("away"); el.classList.remove("back"); }
    /* an off-stage sheet still holds an empty h1; keep it out of the a11y tree */
    const off = el.classList.contains("away");
    el.setAttribute("aria-hidden", String(off));
    el.inert = off;
  });
  active = n>0 ? SHEETS[n-1] : null;
  $("rtype").textContent=n>0?(stack[n-1].slug||"Reading"):"Reading";
  syncSheetLenis();
}

function neighbour(e){
  for(const list of [WORK_ITEMS, CRAFT_ITEMS, POSTS]){
    const i = list.findIndex(x => x.title === e.title);
    if(i > -1 && list.length > 1) return list[(i + 1) % list.length];
  }
  return null;
}

function nextHTML(e){
  const n = neighbour(e);
  if(!n) return "";
  return `<div class="nextup">
    <p class="kicker">Next ${(n.slug||"").toLowerCase()}</p>
    <a class="next-row" href="${n.path}">
      <h3>${n.title}</h3>
      <svg class="ar" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true"><path d="M3 12L12 3M12 3H5.5M12 3v6.5" stroke="currentColor" stroke-width="1.1"/></svg>
    </a>
  </div>`;
}

