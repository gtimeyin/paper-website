/* ---------- boot sequence ----------
   Three honest stages. The only one that actually takes time is the type:
   we wait on document.fonts.ready, capped at 2.2s so a slow font CDN
   can never strand someone on a loading screen. */
const boot=$("boot"), bootFill=$("bootfill"), bootStage=$("bootstage");
const wait=ms=>new Promise(r=>setTimeout(r,ms));

function stage(pct,label){
  bootFill.style.width=pct+"%";
  bootStage.style.opacity=0;
  setTimeout(()=>{bootStage.textContent=label;bootStage.style.opacity=1;},180);
}

function land(){
  document.documentElement.classList.remove("booting");
  boot.classList.add("gone");
  setTimeout(()=>boot.remove(),700);
}

async function runBoot(){
  const still=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if(still){ boot.remove(); document.documentElement.classList.remove("booting"); return; }
  bootFill.style.width="22%";
  await wait(300);
  stage(55,"Laying the paper");
  const fonts = (document.fonts && document.fonts.ready) ? document.fonts.ready : Promise.resolve();
  await Promise.race([fonts, wait(2200)]);
  stage(100,"Setting the type");
  await wait(340);
  land();
}
runBoot();

/* ---------- time of day ----------
   The sun variables come from the visitor's own clock. Elevation peaks at solar
   noon and falls to zero at either end, so the shaft is long, low and amber in
   the morning and evening, and short, steep and near-white at midday.
   To pin this to Lagos instead of the visitor's timezone, build `now` with
   Intl.DateTimeFormat and { timeZone: "Africa/Lagos" }. */
const DAWN=5.5, DUSK=20;
const lerp=(a,b,k)=>a+(b-a)*k;
const mixRGB=(a,b,k)=>a.map((v,i)=>Math.round(lerp(v,b[i],k))).join(",");

function sunState(now){
  const t=now.getHours()+now.getMinutes()/60;

  if(t<=DAWN || t>=DUSK){
    return { rot:-10, x:24, y:-28, w:54, len:150, a:.3,
             c1:"196,212,236", c2:"152,178,216", c3:"118,144,190",
             label:"night — the desk lamp is doing the work" };
  }

  const p=(t-DAWN)/(DUSK-DAWN);      // 0 dawn → 1 dusk
  const e=Math.sin(Math.PI*p);       // elevation: 0 at both ends, 1 at noon
  const low=[255,182,106], high=[255,248,228];

  const label =
    t<7  ? "early light" :
    t<11 ? "morning light" :
    t<15 ? "midday light" :
    t<18 ? "afternoon light" : "evening light";

  return {
    rot: lerp(-46,42,p),   // sweeps across as the day passes
    x:   lerp(-6,56,p),
    y:   lerp(-14,-27,e),
    w:   lerp(54,34,e),    // narrows as the sun climbs
    len: lerp(156,102,e),  // long rake at the ends, short at noon
    a:   lerp(.42,1,e),
    c1: mixRGB(low,high,e),
    c2: mixRGB(low,high,e*0.6),
    c3: mixRGB(low,high,e*0.25),
    label
  };
}

function applySun(){
  const now=new Date(), s=sunState(now), r=document.documentElement.style;
  r.setProperty("--sun-rot", s.rot.toFixed(1)+"deg");
  r.setProperty("--sun-x",   s.x.toFixed(1)+"vw");
  r.setProperty("--sun-y",   s.y.toFixed(1)+"vh");
  r.setProperty("--sun-w",   s.w.toFixed(1)+"vw");
  r.setProperty("--sun-len", s.len.toFixed(1)+"vh");
  r.setProperty("--sun-a",   s.a.toFixed(2));
  r.setProperty("--sun-c1",  s.c1);
  r.setProperty("--sun-c2",  s.c2);
  r.setProperty("--sun-c3",  s.c3);
  /* the readout only exists when the playground is on; the sun still runs without it */
  const note = $("lightnote");
  if(note) note.textContent =
    now.toLocaleTimeString([], {hour:"numeric", minute:"2-digit"}) + " — " + s.label;
}
applySun();
setInterval(applySun, 60000);

