---
import { SITE_URL } from "../lib/site-routes";

const canonicalUrl = new URL("/404", SITE_URL);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonicalUrl} />
    <title>Page not found — Timeyin Gordon</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300..600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      :root{--paper:#f8f7f4;--ink:#17191b;--soft:#707674;--rule:#d8d6ce;--accent:#2e6b53}
      *{box-sizing:border-box}
      html,body{min-height:100%;margin:0}
      body{display:grid;place-items:center;padding:24px;background:#14161a;color:var(--ink);font-family:"Newsreader",Georgia,serif}
      main{width:min(760px,100%);min-height:520px;padding:clamp(32px,7vw,76px);background:var(--paper);box-shadow:-18px 20px 45px rgba(0,0,0,.28);position:relative}
      main::before{content:"";position:absolute;inset:14px -14px -14px 14px;background:#e4523c;z-index:-1;transform:rotate(-1deg)}
      .kicker{margin:0 0 70px;font:500 10px/1.2 "IBM Plex Mono",monospace;letter-spacing:.16em;text-transform:uppercase;color:var(--soft)}
      h1{max-width:560px;margin:0;font-size:clamp(52px,9vw,92px);font-weight:400;line-height:.93;letter-spacing:-.045em}
      h1 span{color:var(--accent)}
      p{max-width:500px;margin:34px 0;font-size:20px;line-height:1.5;color:#43494a}
      nav{display:flex;flex-wrap:wrap;gap:18px 28px;padding-top:24px;border-top:1px solid var(--rule);font:500 10px/1.2 "IBM Plex Mono",monospace;letter-spacing:.1em;text-transform:uppercase}
      a{color:var(--ink);text-underline-offset:4px}
      a:hover{color:var(--accent)}
    </style>
  </head>
  <body>
    <main>
      <p class="kicker">404 — This sheet is missing</p>
      <h1>The page wandered <span>off the desk.</span></h1>
      <p>The address may have changed, or the piece may have been archived.</p>
      <nav aria-label="Useful destinations">
        <a href="/">Home</a>
        <a href="/work">Work</a>
        <a href="/field-notes">Field Notes</a>
        <a href="/about">About</a>
      </nav>
    </main>
  </body>
</html>
